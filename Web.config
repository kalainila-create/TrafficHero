<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- Replace YOUR_SERVER_NAME with whatever's in the "Server name"
         box on SSMS's Connect dialog (e.g. "localhost", ".",
         "DESKTOP-AB12CD3", or "localhost\SQLEXPRESS"). See README.txt
         "DATABASE SETUP" for how to find it and for the App_Data /
         LocalDB alternatives. -->
    <add name="TrafficHeroDB"
         connectionString="Data Source=localhost\SQLEXPRESS01;Initial Catalog=TrafficHeroDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.0" />
    <httpRuntime targetFramework="4.0" />
    <sessionState mode="InProc" timeout="30" />
  </system.web>
</configuration>
